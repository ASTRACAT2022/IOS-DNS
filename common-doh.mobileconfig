<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>PayloadContent</key>
    <array>
        <dict>
            <key>DNSSettings</key>
            <dict>
                <key>DNSProtocol</key>
                <string>HTTPS</string>

                <key>ServerURL</key>
                <string>https://dns.commonnet.work/dns-query</string>
            </dict>

            <key>PayloadDescription</key>
            <string>CommonDNS — защищённый DNS-сервис от Common Network. Использует DNS over HTTPS (DoH) для шифрования DNS-запросов, защиты от подмены DNS-ответов и ограничений на уровне DNS. Инфраструктура включает серверы в Москве и Челябинске для быстрой и стабильной обработки запросов. Работает без VPN и не изменяет внешний IP-адрес. Telegram: https://t.me/commondns</string>

            <key>PayloadDisplayName</key>
            <string>CommonDNS (DoH)</string>

            <key>PayloadIdentifier</key>
            <string>work.commonnet.dns.doh</string>

            <key>PayloadType</key>
            <string>com.apple.dnsSettings.managed</string>

            <key>PayloadUUID</key>
            <string>5B8A3D91-2F64-4E8C-9A73-D1F60B2C5E47</string>

            <key>PayloadVersion</key>
            <integer>1</integer>

            <key>ProhibitDisablement</key>
            <false/>
        </dict>
    </array>

    <key>PayloadDescription</key>
    <string>CommonDNS — зашифрованный DNS-сервис от Common Network. Поддержка DNS over HTTPS, защита DNS-запросов, распределённая инфраструктура в Москве и Челябинске. Совместим с iOS и macOS. Официальный канал: https://t.me/commondns</string>

    <key>PayloadDisplayName</key>
    <string>CommonDNS — Secure DNS</string>

    <key>PayloadIdentifier</key>
    <string>work.commonnet.dns.profile</string>

    <key>PayloadRemovalDisallowed</key>
    <false/>

    <key>PayloadType</key>
    <string>Configuration</string>

    <key>PayloadUUID</key>
    <string>7C2E91A4-6B38-4FD0-8E15-A9D73C5B2046</string>

    <key>PayloadVersion</key>
    <integer>1</integer>
</dict>
</plist>
